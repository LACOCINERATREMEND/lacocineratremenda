# Public site URL, no trailing slash. Used by Stripe return URLs.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43123

# Stripe. Leave empty until the account is connected.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Supabase. Leave empty to keep the local JSON files in data/.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
